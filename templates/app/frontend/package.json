{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint && steiger ./src",
    "lint:ci": "oxlint --format=github && steiger ./src",
    "test": "vitest run",
    "api:types": "node scripts/api-types.mjs",
    "e2e": "node e2e/harness/run.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.92.0",
    "steiger": "0.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
