{
  "name": "@claudalisk/scripts",
  "version": "0.1.0",
  "description": "The scripts of a claudalisk app: the guarded environment scripts (deploy, backup, restore, prune-backups, refresh-dev, init, migrate, check-migrations) and the CI-run scripts (no-comments, check-e2e-locators, install-security-tools, scan-images, zap-baseline, trx-annotations, base-status, free-ports, check-forbidden-files, check-source-hygiene, check-suppressions).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucem-labs/claudalisk.git",
    "directory": "packages/scripts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "!src/**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./cli": "./src/cli.mjs",
    "./deploy": "./src/commands/deploy.mjs",
    "./backup": "./src/commands/backup.mjs",
    "./restore": "./src/commands/restore.mjs",
    "./prune-backups": "./src/commands/prune-backups.mjs",
    "./refresh-dev": "./src/commands/refresh-dev.mjs",
    "./init": "./src/commands/init.mjs",
    "./migrate": "./src/commands/migrate.mjs",
    "./check-migrations": "./src/commands/check-migrations.mjs",
    "./no-comments": "./src/commands/no-comments.mjs",
    "./check-e2e-locators": "./src/commands/check-e2e-locators.mjs",
    "./install-security-tools": "./src/commands/install-security-tools.mjs",
    "./scan-images": "./src/commands/scan-images.mjs",
    "./zap-baseline": "./src/commands/zap-baseline.mjs",
    "./trx-annotations": "./src/commands/trx-annotations.mjs",
    "./base-status": "./src/commands/base-status.mjs",
    "./free-ports": "./src/commands/free-ports.mjs",
    "./check-forbidden-files": "./src/commands/check-forbidden-files.mjs",
    "./check-source-hygiene": "./src/commands/check-source-hygiene.mjs",
    "./check-suppressions": "./src/commands/check-suppressions.mjs",
    "./fake-runner": "./src/fake-runner.mjs",
    "./package.json": "./package.json"
  }
}
